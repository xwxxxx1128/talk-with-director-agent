# ===== 项目自定义规则 =====

# 前端依赖与构建产物
frontend/node_modules/
frontend/dist/
frontend/package-lock.json

# 原著书籍与清洗素材
*.mobi
*.epub
*.pdf
output/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 本地运行产物
config.json
*.db

# 向量数据库缓存
chroma_db/
lance_db/

# 编辑器与系统文件
.vscode/
.DS_Store

# ===== Python 模板规则（GitHub Python .gitignore 精选） =====

# Byte-compiled / optimized / DLL files
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Environments
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# PyPI configuration file
.pypirc

# Streamlit
.streamlit/secrets.toml

# IDE
.idea/

# ===== LoRA 微调产物（推理不需要，整个 adapter 目录不入库） =====
